# Copy this file to `.env` and fill in the key(s) you actually use.
# `.env` is gitignored — never commit real keys.

# Provide the key(s) for whichever provider LLM_MODEL points to.
# init_chat_model auto-detects the right variable from the model prefix.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Which model the pipeline talks to. Switch providers by editing this line.
#   anthropic:claude-3-5-sonnet-latest
#   openai:gpt-4o
#   google_genai:gemini-1.5-pro
LLM_MODEL=anthropic:claude-3-5-sonnet-latest
